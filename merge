local kingPos = CFrame.new(-8665.4, 17.21, -5792.9)
local kingPortal = Vector3.new(-123, 18, -710)   -- fallback: the "Travel to Muscle King?" circle
local kingCooldown = 0

-- the game's own travel circle for Muscle King (workspace.areaCircles.<model> with areaName = "Muscle King")
local function findKingCircle()
    local folder = workspace:FindFirstChild("areaCircles")
    if not folder then return nil end
    for _, m in ipairs(folder:GetChildren()) do
        local n = m:FindFirstChild("areaName")
        if m:IsA("Model") and n and n.Value == "Muscle King" then return m end
    end
end

local function inKingGym()
    local r = hrp()
    return r and (r.Position - kingPos.Position).Magnitude < 400
end

-- same thing the YES button does: InvokeServer("travelToArea", circle). No GUI clicking.
local function enterKing()
    if tick() < kingCooldown then return end
    kingCooldown = tick() + 6          -- never retry faster than this
    local r = hrp()
    if not r then return end
    local circle = findKingCircle()
    if not circle or not rEvents:FindFirstChild("areaTravelRemote") then
        tp(kingPos)                    -- older version without the travel circle: plain teleport
        return
    end
    -- stand on the circle first so any server-side proximity check passes
    local inner = circle:FindFirstChild("circleInner")
    tp(CFrame.new((inner and inner:IsA("BasePart") and inner.Position or kingPortal) + Vector3.new(0, 3, 0)))
    task.wait(0.4)
    pcall(function() rEvents.areaTravelRemote:InvokeServer("travelToArea", circle) end)
    -- hands off the character while the game moves us
    local t1 = tick()
    while tick() - t1 < 8 and not inKingGym() do task.wait(0.2) end
    if inKingGym() then
        task.wait(0.5)
        tp(kingPos)
    end
end

