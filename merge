            healthLbl.Text = "Enemy Health: " .. fmt(health)
            dmgLbl.Text = "Your Damage: " .. fmt(damage)
            local hits = damage > 0 and math.max(1, math.ceil(health / damage)) or math.huge
            hitsLbl.Text = "Hits to Kill: " .. (hits > 100 and "100+" or tostring(hits))
        end
    end
end)

