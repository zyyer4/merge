local function multiplier(plr, ultName, perLevel, petA, petB)
    local m = 1
    local uf = plr:FindFirstChild("ultimatesFolder")
    local u = uf and uf:FindFirstChild(ultName)
    if u then m = m + perLevel * (u.Value or 0) end
    local ep = plr:FindFirstChild("equippedPets")
    if ep then
        for _, v in ipairs(ep:GetChildren()) do
            if v:IsA("ObjectValue") and v.Value then
                local n = v.Value.Name:lower()
                if n:find(petA) and n:find(petB) then m = m + 0.5 end
            end
        end
    end
    return m
end
task.spawn(function()
    while task.wait(0.25) do
        if inspect and inspect.Parent then
            specName.Text = "Name: " .. inspect.DisplayName .. " (" .. inspect.Name .. ")"
