----------------------------------------------------------------------
-- shared window proxy: prefixes tab names, and lets only the Info tab open on load
----------------------------------------------------------------------
local firstTab, firstShow

local function makeWindowProxy(prefix)
    local proxy = {}
    function proxy:AddTab(name, ...)
        local tab = window:AddTab(prefix .. " " .. tostring(name), ...)
        pcall(function()
            local realShow = tab.Show
            if not firstTab then firstTab, firstShow = tab, realShow end
            tab.Show = function() end
        end)
        return tab
    end
    return setmetatable(proxy, {
        __index = function(_, key)
            local v = window[key]
            if type(v) == "function" then
                return function(_, ...) return v(window, ...) end
            end
            return v
        end,
    })
end

----------------------------------------------------------------------
-- Inferno API  ->  Elerium API adapter
--   CreateWindow/CreateTab/AddSection/AddToggle/AddButton/AddDropdown/AddSlider/AddInput/
--   AddParagraph/AddSeperator/AddLine/SetNotification
----------------------------------------------------------------------
local function makeInfernoCompat(win)
    local Compat = {}

    function Compat:SetNotification(o)
        o = o or {}
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = tostring(o.Title or "Mystery Hub"),
                Text = tostring(o.Content or o.Description or ""),
                Duration = o.Delay or 3,
            })
        end)
    end

    local function wrap(container)
        local C = {}

        function C:AddParagraph(o)
            o = o or {}
            if o.Title and o.Title ~= "" then
                container:AddLabel("[ " .. tostring(o.Title) .. " ]")
            end
            for line in tostring(o.Content or ""):gmatch("[^\r\n]+") do
                container:AddLabel("   " .. line)
            end
        end

        function C:AddSeperator(o)
            local t = type(o) == "table" and (o.Title or o.Name) or ""
            container:AddLabel("----- " .. tostring(t) .. " -----")
        end
        C.AddSeparator = C.AddSeperator

        function C:AddLine() end

        function C:AddButton(o)
            o = o or {}
            return container:AddButton(tostring(o.Title or o.Name or "Button"), function()
                if o.Callback then o.Callback() end
            end)
        end

        function C:AddToggle(o)
            o = o or {}
            local sw = container:AddSwitch(tostring(o.Title or "Toggle"), function(v)
                if o.Callback then o.Callback(v) end
            end)
            if o.Default and sw and sw.Set then
                pcall(function() sw:Set(true) end)
            end
            return sw
        end

        function C:AddInput(o)
            o = o or {}
            return container:AddTextBox(tostring(o.Title or "Input"), function(text)
                if o.Callback then o.Callback(text) end
            end)
        end

        function C:AddSlider(o)
            o = o or {}
            local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
            local cb = o.Callback or function() end
            if inc >= 1 and container.AddSlider then
                local ok, s = pcall(function()
                    return container:AddSlider(tostring(o.Title or "Slider"), function(v) cb(v) end, { min = min, max = max })
                end)
                if ok and s then
                    if o.Default ~= nil and s.Set then pcall(function() s:Set(o.Default) end) end
                    return s
                end
            end
            -- decimals (or no slider support): type the value instead
            return container:AddTextBox(string.format("%s (%s - %s)", tostring(o.Title or "Value"), min, max), function(text)
                local n = tonumber(text)
                if n then cb(math.clamp(n, min, max)) end
            end)
        end

        function C:AddDropdown(o)
            o = o or {}
            local multi = o.Multi == true
            local cb = o.Callback
            local selected = {}
            local info
            local obj = {}

            local function snapshot()
                local t = {}
                for i, v in ipairs(selected) do t[i] = v end
                return t
            end
            local function refreshInfo()
                if info then
                    pcall(function()
                        info.Text = "   selected: " .. (#selected > 0 and table.concat(selected, ", ") or "none")
                    end)
                end
            end

            local dd = container:AddDropdown(tostring(o.Title or "Select"), function(text)
                if multi then
                    local idx = table.find(selected, text)
                    if idx then table.remove(selected, idx) else table.insert(selected, text) end
                    refreshInfo()
                else
                    selected = { text }
                end
                if cb then cb(snapshot()) end
            end)
            for _, opt in ipairs(o.Options or {}) do dd:Add(opt) end
            if multi then info = container:AddLabel("   selected: none") end

            if type(o.Default) == "table" and #o.Default > 0 then
                selected = multi and { table.unpack(o.Default) } or { o.Default[1] }
                refreshInfo()
                if cb then pcall(cb, snapshot()) end
            end

            function obj:SetOptions(list)
                pcall(function() dd:Clear() end)
                local keep = {}
                for _, opt in ipairs(list or {}) do
                    dd:Add(opt)
                    if table.find(selected, opt) then table.insert(keep, opt) end
                end
                selected = keep
                refreshInfo()
                if multi and cb then pcall(cb, snapshot()) end
            end
            obj.Refresh = obj.SetOptions
            obj.Update = obj.SetOptions
            function obj:Add(opt) dd:Add(opt) end
            function obj:Clear()
                pcall(function() dd:Clear() end)
                selected = {}
                refreshInfo()
            end
            obj.Dropdown = dd
            return obj
        end

        function C:AddSection(name)
            if container.AddFolder then
                return wrap(container:AddFolder(tostring(name)))
            end
            container:AddLabel("===== " .. tostring(name) .. " =====")
            return wrap(container)
        end

        return C
    end

    function Compat:CreateWindow(_)
        local W = {}
        function W:CreateTab(t)
            local name = type(t) == "table" and (t.Name or t.Title) or tostring(t)
            return wrap(win:AddTab(name))
        end
        return W
    end

    return Compat
end

