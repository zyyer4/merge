local function packCalc(title, inputTitle, factor)
    local folder = Calc:AddFolder(title)
    local base = 0
    folder:AddTextBox(inputTitle .. " (e.g. 1.27Qa, 500T, 30B)", function(t) base = parseAmount(t) end)
    local labels = {}
    for i = 1, 8 do labels[i] = folder:AddLabel(i .. " pack(s): -") end
    folder:AddButton("Calculate", function()
        for i = 1, 8 do
            labels[i].Text = base <= 0 and (i .. " pack(s): -") or (i .. " pack(s): " .. fmt(base * factor * (1 + i * 0.335)))
        end
    end)
end
