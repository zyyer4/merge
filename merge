-- walk on water (parts built once, toggled)
local waterParts, waterBuilt = {}, false
local function buildWater()
    if waterBuilt then return end
    waterBuilt = true
    local size, total, start = 2048, 24000, Vector3.new(-2, -9.5, -2)
    local n = math.ceil(total / size)
    for x = 0, n - 1 do
        for z = 0, n - 1 do
            for _, sx in ipairs({1, -1}) do
                for _, sz in ipairs({1, -1}) do
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(size, 1, size)
                    p.Position = start + Vector3.new(sx * x * size, 0, sz * z * size)
                    p.Anchored, p.Transparency, p.CanCollide = true, 1, false
                    p.Name = "WaterWalkPart"
                    p.Parent = workspace
                    table.insert(waterParts, p)
                end
            end
        end
    end
end
Main:AddSwitch("Walk on Water", function(on)
    if on then buildWater() end
    for _, p in ipairs(waterParts) do if p.Parent then p.CanCollide = on end end
end)

