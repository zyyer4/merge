                specLabels[d[1]].Text = s and string.format("%s: %s (%s)", d[1], fmt(s.Value), commas(s.Value)) or (d[1] .. ": 0")
            end
            local dura = getStat(inspect, "Durability")
            local str = getStat(LP, "Strength")
            local health = (dura and dura.Value or 0) * multiplier(inspect, "Infernal Health", 0.15, "mighty", "monster")
