local playlistFile = "UnifiedHubPlaylist_" .. LP.Name .. ".txt"
local playlist, idx, mp3Url, sound, paused, fileCount = {}, 0, "", nil, false, 0
pcall(function()
    if isfile(playlistFile) then
        for u in readfile(playlistFile):gmatch("[^,]+") do table.insert(playlist, u) end
    end
end)
local function savePlaylist() pcall(function() writefile(playlistFile, table.concat(playlist, ",")) end) end
local timeLbl = Music:AddLabel("00:00 / 00:00")
local function mmss(s) s = math.floor(s or 0) return string.format("%02d:%02d", math.floor(s / 60), s % 60) end

local function playUrl(url)
    if url == "" then return end
    fileCount = fileCount + 1
    local f = "UnifiedHubMusic_" .. fileCount .. ".mp3"
    local ok = pcall(function() writefile(f, game:HttpGet(url)) end)
    if not ok then notify("Music", "Could not download that URL") return end
    if sound then sound:Destroy() end
    sound = Instance.new("Sound")
    sound.Name, sound.Parent, sound.Volume = "UnifiedHubSound", SoundService, 1
    sound.SoundId = getcustomasset(f)
    sound:Play()
    paused = false
    sound.Ended:Connect(function()
        if not sound.Looped and not paused and #playlist > 0 then
            idx = idx % #playlist + 1
            playUrl(playlist[idx])
        end
    end)
end
task.spawn(function()
    while task.wait(0.2) do
        if sound and sound.Parent then timeLbl.Text = mmss(sound.TimePosition) .. " / " .. mmss(sound.TimeLength) end
    end
end)

