-- callback factory: runs fn every `delay` seconds while the switch is on (one loop at a time)
local function loopSwitch(key, delay, fn, onChange)
    return function(on)
        if on then
            local id = {}
            S[key] = id
            task.spawn(function()
                while S[key] == id do
                    pcall(fn)
                    task.wait(delay)
                end
            end)
        else
            S[key] = nil
        end
        if onChange then pcall(onChange, on) end
    end
end

local suffixes = {{1e15, "Qa"}, {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}
local function fmt(n)
    n = tonumber(n) or 0
    for _, s in ipairs(suffixes) do
        if math.abs(n) >= s[1] then return string.format("%.2f%s", n / s[1], s[2]) end
    end
    return tostring(math.floor(n))
end
local function commas(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    local k
    repeat s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
    return s
end
local function parseAmount(text)
    local n, suf = tostring(text):match("^%s*([%d%.]+)%s*(%a*)")
    n = tonumber(n)
    if not n then return 0 end
    local mult = {k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, q = 1e15}
    return n * (mult[suf:lower()] or 1)
end

-- player dropdowns that stay in sync with the server
local playerDrops = {}
local function pText(p) return p.DisplayName .. " | " .. p.Name end
local function getP(text)
    local n = text and tostring(text):match("| (.+)$")
    return n and Players:FindFirstChild(n)
end
local function refill(e)
    -- the Elerium dropdown has no :Clear(); each :Add() returns an object with :Remove()
    for _, o in ipairs(e.items) do pcall(function() o:Remove() end) end
    e.items = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if e.self or p ~= LP then
            local ok, o = pcall(function() return e.d:Add(pText(p)) end)
            if ok and o then table.insert(e.items, o) end
        end
    end
end
local function playerDrop(parent, title, cb, includeSelf)
    local d = parent:AddDropdown(title, function(t)
        local p = getP(t)
        if p then cb(p) end
    end)
    local e = {d = d, self = includeSelf, items = {}}
    table.insert(playerDrops, e)
    refill(e)
    return d
end
Players.PlayerAdded:Connect(function() for _, e in ipairs(playerDrops) do refill(e) end end)
Players.PlayerRemoving:Connect(function() task.defer(function() for _, e in ipairs(playerDrops) do refill(e) end end) end)

