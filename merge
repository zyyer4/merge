local function equipTool(name)
    local c, bp = LP.Character, LP:FindFirstChild("Backpack")
    if not c or c:FindFirstChild(name) then return c and c:FindFirstChild(name) end
    local t = bp and bp:FindFirstChild(name)
    local h = hum()
