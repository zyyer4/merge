local whitelist, killlist = {}, {}
local function listText(t)
    local names = {}
    for n in pairs(t) do table.insert(names, n) end
    return #names == 0 and "None" or table.concat(names, ", ")
end

local function alive(p)
    local c = p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart")
end
local function ensurePunch()
    local c = LP.Character
    if not c then return false end
    if c:FindFirstChild("Punch") then return true end
    local t = LP.Backpack:FindFirstChild("Punch")
    if t then t.Parent = c return true end
    return false
end
local killTP = true   -- "Teleport to targets while killing"
local function hit(p, noTP)
    local c = LP.Character
    local root = alive(p)
    local me = hrp()
    if not (c and root and me) then return end
    local hands = {}
    for _, n in ipairs({"RightHand", "LeftHand", "Right Arm", "Left Arm"}) do
        local h = c:FindFirstChild(n)
        if h then table.insert(hands, h) end
    end
    if #hands == 0 then return end
    -- real contact beats faked touches: stand right behind the target
    if killTP and not noTP and (me.Position - root.Position).Magnitude > 4 then
        me.CFrame = root.CFrame * CFrame.new(0, 0, 2)
        me.AssemblyLinearVelocity = Vector3.zero
    end
    local tool = c:FindFirstChild("Punch")
    if not tool then ensurePunch() tool = c:FindFirstChild("Punch") end
    if tool then
        if tool:FindFirstChild("attackTime") then tool.attackTime.Value = 0 end
        pcall(function() tool:Activate() end)      -- the real swing (animation + punch event)
    end
    for _, h in ipairs(hands) do
        firetouchinterest(h, root, 0)
        firetouchinterest(h, root, 1)
    end
    fire("punch", "rightHand") fire("punch", "leftHand")
end

