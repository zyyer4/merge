-- This version: ReplicatedStorage.Configs holds brawlPhase ("Idle"/"Joining"/"Starting"/"Active"),
-- brawlRound, brawlStarted, brawlInProgress. Joining = brawlEvent:FireServer("joinBrawl", <current round>);
-- the server ignores a join without the round number, and attacks are blocked until the brawl is Active.
local brawlCfg = RS:FindFirstChild("Configs")
local function bcfg(name) return brawlCfg and brawlCfg:FindFirstChild(name) end
local function inBrawl(p)
    local c = (p or LP).Character
    return c ~= nil and c:FindFirstChild("lastMapCFrame") ~= nil   -- the game adds this to fighters
end
local function joinBrawl()
    local round = bcfg("brawlRound")
    if round then
        rEvents.brawlEvent:FireServer("joinBrawl", round.Value)
    else
        rEvents.brawlEvent:FireServer("joinBrawl")                   -- older versions: no round argument
    end
end
local lastJoinedRound = -1
local function joinBrawlIfPrompted()
    local phase, round = bcfg("brawlPhase"), bcfg("brawlRound")
    if phase and round then
        if phase.Value == "Joining" and round.Value ~= lastJoinedRound and not inBrawl() then
            lastJoinedRound = round.Value
            joinBrawl()
        end
        return
    end
    -- old layout fallback
    local gg = LP.PlayerGui:FindFirstChild("gameGui")
    if gg and gg:FindFirstChild("brawlJoinLabel") and gg.brawlJoinLabel.Visible then
        joinBrawl()
        gg.brawlJoinLabel.Visible = false
    end
end
local function brawlActive()
    local started, phase = bcfg("brawlStarted"), bcfg("brawlPhase")
    if phase then return phase.Value == "Active" end
    if started then return started.Value end
    local old = RS:FindFirstChild("brawlInProgress", true)
    return old and old.Value
end

