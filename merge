----------------------------------------------------------------------
-- MILLION WARRIOR KILLER
-- Workspace.enemyNPCs["Battle Island"] has one "enemySpawn" folder per enemy:
--   enemySpawn.stats.Health / MaxHealth (NumberValues)  +  the enemy Model (with HumanoidRootPart).
-- Visits every ALIVE enemy one by one (following it as it moves), auto punch on, repeats forever.
-- Falls back to the recorded coordinates if the enemy folders can't be found.
----------------------------------------------------------------------
local mw = {
    dwell = 20,        -- max seconds on one enemy before moving on
    height = 0,        -- vertical offset
    back = 2.5,        -- studs in front of the enemy
    fallback = {
        Vector3.new(-4904.69, 9.23, 3651.11), Vector3.new(-5356.31, 15.63, 3724.16), Vector3.new(-5015.58, 23.70, 3764.33),
        Vector3.new(-4869.46, 15.63, 3817.51), Vector3.new(-4932.25, 16.81, 4005.14), Vector3.new(-5035.44, 19.28, 4094.55),
        Vector3.new(-5200.25, 15.63, 4133.70), Vector3.new(-5384.51, 23.66, 4072.95), Vector3.new(-5479.27, 23.70, 3969.61),
        Vector3.new(-5522.32, 22.04, 3805.46), Vector3.new(-5350.38, 16.78, 3521.58), Vector3.new(-5463.22, 23.66, 3619.46),
    },
}

-- every enemy slot: {spawn = folder, hp = Health value, max = MaxHealth value}
function mw.slots()
    local out = {}
    local root = workspace:FindFirstChild("enemyNPCs")
    if not root then return out end
    for _, d in ipairs(root:GetDescendants()) do
        if d.Name == "enemySpawn" and d:IsA("Folder") then
            local st = d:FindFirstChild("stats")
            local hp = st and st:FindFirstChild("Health")
            if hp then table.insert(out, {spawn = d, hp = hp, max = st:FindFirstChild("MaxHealth")}) end
        end
    end
    return out
end

-- the live enemy model + its root inside a slot (nil while it is dead / respawning)
function mw.enemy(slot)
    for _, m in ipairs(slot.spawn:GetChildren()) do
        if m:IsA("Model") then
            local r = m:FindFirstChild("HumanoidRootPart")
            if r then return m, r end
        end
    end
end

function mw.punch(targetRoot)
    local c = LP.Character
    local p = equipTool("Punch")
    if p then
        if p:FindFirstChild("attackTime") then p.attackTime.Value = 0 end
        pcall(function() p:Activate() end)
    end
    if c and targetRoot then
        for _, n in ipairs({"RightHand", "LeftHand"}) do
            local h = c:FindFirstChild(n)
            if h then
                pcall(function() firetouchinterest(h, targetRoot, 0) firetouchinterest(h, targetRoot, 1) end)
            end
        end
    end
    fire("punch", "rightHand") fire("punch", "leftHand")
end

function mw.go(pos, lookAt)
    local r = hrp()
    if not r then return end
    local at = pos + Vector3.new(0, mw.height, mw.back)
    r.CFrame = CFrame.lookAt(at, Vector3.new(lookAt.X, at.Y, lookAt.Z))
    r.AssemblyLinearVelocity = Vector3.zero
end

MW:AddLabel("Million Warrior Killer").TextSize = 22
mw.status = MW:AddLabel("Status: off")
MW:AddTextBox("Max seconds per enemy (default 20)", function(t)
    local n = tonumber(t)
    if n and n > 0 then mw.dwell = n end
end, {["clear"] = false})
MW:AddTextBox("Distance in front of enemy (default 2.5)", function(t)
    local n = tonumber(t)
    if n then mw.back = n end
end, {["clear"] = false})
MW:AddTextBox("Height offset (default 0)", function(t)
    local n = tonumber(t)
    if n then mw.height = n end
end, {["clear"] = false})

MW:AddSwitch("Million Warrior Killer", function(on)
    if not on then
        S.mwKiller = nil
        pcall(function() mw.status.Text = "Status: off" end)
        unequipTool("Punch")
        return
    end
    local id = {}
    S.mwKiller = id
    task.spawn(function()   -- constant auto punch while enabled
        while S.mwKiller == id do
            pcall(mw.punch, mw.curRoot)
            task.wait(0.05)
        end
        mw.curRoot = nil
    end)
    task.spawn(function()   -- teleport loop
        local idx = 0
        while S.mwKiller == id do
            local slots = mw.slots()
            if #slots == 0 then
                -- enemy folders not found: just visit the recorded coordinates 1 by 1
                for i, pos in ipairs(mw.fallback) do
                    if S.mwKiller ~= id then break end
                    mw.curRoot = nil
                    pcall(function() mw.status.Text = ("Status: spot %d/%d (recorded)"):format(i, #mw.fallback) end)
                    local t0 = tick()
                    while S.mwKiller == id and tick() - t0 < 3 do
                        mw.go(pos + Vector3.new(0, 3, -mw.back), pos)
                        task.wait()
                    end
                end
            else
                -- next alive enemy after the last one we did (round-robin = 1 by 1, on repeat)
                local picked
                for step = 1, #slots do
                    local sl = slots[(idx + step - 1) % #slots + 1]
                    local m, r = mw.enemy(sl)
                    if m and r and sl.hp.Value > 0 then
                        picked = sl
                        idx = (idx + step) % #slots
                        break
                    end
                end
                if not picked then
                    mw.curRoot = nil
                    pcall(function() mw.status.Text = "Status: all enemies dead, waiting for respawn..." end)
                    task.wait(0.5)
                else
                    local t0 = tick()
                    local slotIdx = idx == 0 and #slots or idx
                    while S.mwKiller == id and tick() - t0 < mw.dwell do
                        local m2, r2 = mw.enemy(picked)
                        if not (m2 and r2) or picked.hp.Value <= 0 then break end   -- killed (or despawned)
                        mw.curRoot = r2
                        mw.go(r2.Position, r2.Position)
                        pcall(function()
                            mw.status.Text = ("Status: %d/%d  %s  (%s / %s HP)"):format(
                                slotIdx, #slots, m2.Name, fmt(picked.hp.Value), picked.max and fmt(picked.max.Value) or "?")
                        end)
                        RunService.Heartbeat:Wait()
                    end
                end
            end
        end
    end)
end)

